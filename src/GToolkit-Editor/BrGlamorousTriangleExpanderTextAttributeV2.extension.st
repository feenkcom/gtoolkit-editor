Extension { #name : 'BrGlamorousTriangleExpanderTextAttributeV2' }

{ #category : '*GToolkit-Editor' }
BrGlamorousTriangleExpanderTextAttributeV2 >> gtExternalTextConfigureAppendingAttribute: anAttribute [
	super gtExternalTextConfigureAppendingAttribute: anAttribute.
	
	anAttribute beExactWidth: 16.
	anAttribute beExactHeight: 16.
]
